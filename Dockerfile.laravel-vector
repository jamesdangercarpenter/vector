# Custom Vector image for Laravel Cloud log drains — this fork adds delivery-health
# observability to the aws_s3 sink (see changelog.d/s3_delivery_success_log). Built
# from source so the fork changes are included, then packaged into a slim runtime.
#
# Feature set matches what the operator renders into a drain's Vector config: a kafka
# source, internal_metrics + demo_logs sources, remap/filter transforms, and the
# aws_s3 + prometheus_exporter sinks. Widen FEATURES if the drain pipeline grows.
#
# Target platform: linux/arm64 — the whole Laravel Cloud fleet (operator + all
# cstmr clusters) runs on Graviton/arm64 nodes, so no x86 build is needed.

# ---- build stage -------------------------------------------------------------
FROM rust:1.95-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake perl clang libclang-dev pkg-config \
        protobuf-compiler libssl-dev libsasl2-dev zlib1g-dev unzip git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /vector
COPY . .

# `api` is required because the operator-rendered config enables Vector's local
# API (api.enabled on 127.0.0.1:8686); it is feature-gated, so omitting it makes
# Vector reject the config with "unknown field `api`".
ARG FEATURES="api,sources-kafka,sources-internal_metrics,sources-demo_logs,transforms-remap,transforms-filter,sinks-aws_s3,sinks-prometheus"

# Build-speed/size overrides for the dev image. Vector's release profile is tuned
# for max runtime throughput (lto="fat", codegen-units=1) — the slowest possible to
# compile and unnecessary for a log-drain sidecar. Disabling LTO and parallelizing
# codegen roughly halves the cold compile; stripping shrinks the binary. Override via
# env so Vector's Cargo.toml is untouched.
ENV CARGO_PROFILE_RELEASE_LTO=false \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 \
    CARGO_PROFILE_RELEASE_STRIP=true
# Cache the cargo registry/git and the target dir across builds so an incremental
# rebuild recompiles only changed crates instead of the whole graph. Cache-mount
# contents are not committed to the layer, so copy the binary out to a real path.
# (Cross-build reuse requires a persistent buildx builder — see the CI workflow.)
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/vector/target,sharing=locked \
    cargo build --release --bin vector --no-default-features --features "${FEATURES}" \
    && cp /vector/target/release/vector /vector/vector

# ---- runtime stage -----------------------------------------------------------
FROM debian:bookworm-slim

# wget is required by the operator's drain readiness/liveness probes, which
# exec `wget -q -O- http://127.0.0.1:8686/health` against Vector's local API.
# The public timberio alpine image bundled it (busybox); debian-slim does not.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libssl3 libsasl2-2 zlib1g wget \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/vector

COPY --from=builder /vector/vector /usr/bin/vector

# Vector reads its config from /etc/vector/vector.yaml (the operator mounts it there).
ENTRYPOINT ["/usr/bin/vector"]
